{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "compodoc": "npx compodoc -p tsconfig.json -s",
    "test": "ng test",
    "lint": "ng lint",
    "lint:eslint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "prettier:fix": "prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "migrate-inject": "ng generate @angular/core:inject",
    "lint:fix-unused": "eslint . --ext .ts --fix",
    "fix:all": "npm run lint:fix && npm run format",
    "lint:full-fix": "npm run lint:fix && npm run prettier:fix && npm run migrate-inject && npm run lint:fix-unused"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@auth0/angular-jwt": "^5.2.0",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@sentry/angular": "^10.9.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.4.7",
    "jsbarcode": "^3.12.1",
    "ng2-charts": "^6.0.1",
    "ngx-logger": "^5.0.12",
    "ngx-toastr": "^18.0.0",
    "pdfmake": "^0.2.20",
    "rxjs": "~7.8.0",
    "uuid": "^13.0.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/localize": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@compodoc/compodoc": "^1.1.26",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/pdfmake": "^0.2.12",
    "angular-eslint": "20.2.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^9.1.4",
    "husky": "^8.0.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "~5.4.0",
    "typescript-eslint": "8.40.0"
  },
  "type": "module"
}
